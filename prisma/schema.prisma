generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id          Int    @id @default(autoincrement())
  fullName    String
  headline    String
  summary     String @db.Text // Text panjang
  email       String
  linkedin    String
  github      String?
  location    String
  avatarUrl   String?
  resumeUrl   String? 
}

model Education {
  id          Int     @id @default(autoincrement())
  school      String
  degree      String
  period      String
  description String  @db.Text
  imageUrl    String?
  order       Int     @default(0)
}

model Experience {
  id          Int     @id @default(autoincrement())
  role        String
  company     String
  period      String
  type        String
  description String  @db.Text
  imageUrl    String?
  order       Int     @default(0)
}

model Project {
  id          Int     @id @default(autoincrement())
  name        String
  role        String
  techStack   String
  description String  @db.Text
  period      String
  imageUrl    String?
  repoUrl     String?
  demoUrl     String?
  order       Int     @default(0)
}

model Organization {
  id          Int     @id @default(autoincrement())
  name        String
  role        String
  period      String
  description String  @db.Text
  order       Int     @default(0)
}

model Skill {
  id       Int    @id @default(autoincrement())
  category String
  items    String
  order    Int    @default(0)
}

model Certification {
  id     Int    @id @default(autoincrement())
  name   String
  issuer String
  year   String
  order  Int    @default(0)
}

model Language {
  id    Int    @id @default(autoincrement())
  name  String
  level String
  order Int    @default(0)
}